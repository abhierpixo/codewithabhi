{
  "//": "VS Code settings for RECORDING ONLY. Create a separate profile so your",
  "//_2": "daily setup is untouched: Gear icon > Profiles > New Profile > 'Recording',",
  "//_3": "then paste this into that profile's settings.json.",

  "//_legibility": "Sized so code stays readable on a phone. Feels absurd to type in. Correct.",
  "editor.fontSize": 20,
  "editor.fontFamily": "'JetBrains Mono', Menlo, monospace",
  "editor.lineHeight": 1.7,
  "editor.fontLigatures": true,
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.fontFamily": "'JetBrains Mono', Menlo, monospace",
  "editor.wordWrap": "on",

  "//_cursor": "A fat solid caret is findable on a 1080p recording; a thin blinking one is not.",
  "editor.cursorWidth": 3,
  "editor.cursorBlinking": "solid",
  "editor.renderLineHighlight": "all",

  "//_autocomplete": "THE IMPORTANT ONE. If Copilot or IntelliSense finishes the line while you are teaching a beginner to type it, the lesson is ruined and the viewer is confused about what they were supposed to write. All off.",
  "editor.inlineSuggest.enabled": false,
  "editor.quickSuggestions": { "other": false, "comments": false, "strings": false },
  "editor.suggestOnTriggerCharacters": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.parameterHints.enabled": false,
  "editor.hover.enabled": false,
  "editor.tabCompletion": "off",
  "github.copilot.enable": { "*": false },

  "//_chrome": "Strip everything that is not the code you are talking about.",
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "breadcrumbs.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.editor.showTabs": "single",
  "editor.renderWhitespace": "none",
  "editor.occurrencesHighlight": "off",
  "explorer.compactFolders": false,
  "workbench.tree.indent": 16,

  "//_noise": "Nothing that can pop up mid-take.",
  "workbench.notifications.doNotDisturb": true,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",
  "problems.decorations.enabled": false,
  "update.showReleaseNotes": false,
  "telemetry.telemetryLevel": "off",
  "workbench.startupEditor": "none",
  "window.commandCenter": false,

  "//_theme": "Match codingwithabhi.com so the videos and the site read as one product.",
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.colorCustomizations": {
    "editor.background": "#0A0F1E",
    "sideBar.background": "#0F172A",
    "activityBar.background": "#0F172A",
    "editorGroupHeader.tabsBackground": "#0F172A",
    "tab.activeBackground": "#111C33",
    "terminal.background": "#0B1120",
    "editorCursor.foreground": "#34D399",
    "editor.lineHighlightBackground": "#111C3355",
    "editor.selectionBackground": "#2563EB55"
  }
}
